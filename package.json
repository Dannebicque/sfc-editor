{
  "name": "grafcet-studio",
  "private": true,
  "version": "0.1.0",
  "description": "Éditeur / validateur de GRAFCET (IEC 60848), local-first.",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
