# Copier en .env (jamais dans git).
DOMAIN=grafcet.exemple.org
PUBLIC_URL=https://grafcet.exemple.org
# SMTP obligatoire en production (vérification d'email, mot de passe oublié, invitations).
SMTP_URL=smtps://utilisateur:motdepasse@smtp.exemple.org:465
MAIL_FROM=GRAFCET <no-reply@exemple.org>
# 0 : seules les personnes invitées peuvent créer un compte.
ALLOW_REGISTRATION=1
# Offres : la co-édition (inviter des membres) est réservée aux comptes « teacher » (attribués avec
# `pnpm --filter @grafcet/server plan <email> teacher`). Retirer la ligne pour qu'elle reste ouverte à tous.
COLLAB_REQUIRES_PLAN=1
# Projets en ligne par compte gratuit (la landing affiche 5 : voir packages/editor/src/limits-config.ts).
MAX_PROJECTS_PER_USER=5
