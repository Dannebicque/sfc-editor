{$DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Frame-Options DENY
		Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' wss://{$DOMAIN}; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
	}
	# L'application sert l'éditeur, l'API et le WebSocket : une seule origine (cookies de session sans CORS).
	reverse_proxy app:8787
}
